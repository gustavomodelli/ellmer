# -----------------------------------------------------------------------------
# 5) SERVIDOR
# -----------------------------------------------------------------------------
server <- function(input, output, session) {
  
  # Monta o bloco de dados a partir dos campos preenchidos (ignora vazios)
  montar_prompt <- function() {
    campo <- function(rotulo, valor) {
      valor <- trimws(valor %||% "")
      if (nzchar(valor)) paste0("- ", rotulo, ": ", valor, "\n") else ""
    }
    doador <- input$doador %||% "Nao informado"
    if (identical(doador, "Nao informado")) doador <- ""
    
    bloco <- paste0(
      "== Contexto ==\n",
      campo("Tempo pos-Tx (meses)", input$tempo_tx),
      campo("Tipo de doador", doador),
      campo("Ultimo episodio de rejeicao", input$rejeicao),
      "== Imunossupressao ==\n",
      campo("Tacrolimo nivel de vale (ng/mL)", input$tacro_nivel),
      campo("Tacrolimo dose", input$tacro_dose),
      campo("Ciclosporina", input$ciclosporina),
      campo("Micofenolato/Azatioprina", input$micofenolato),
      campo("Prednisona", input$prednisona),
      campo("mTORi", input$mtor),
      campo("Adesao (7 dias)", input$adesao),
      campo("Profilaxias em uso", input$profilaxias),
      "== Sinais vitais ==\n",
      campo("PA", input$pa), campo("FC", input$fc), campo("Temp", input$temp),
      campo("Peso", input$peso), campo("IMC", input$imc),
      "== Exames laboratoriais ==\n",
      campo("Creatinina (mg/dL)", input$creatinina),
      campo("eTFG", input$egfr), campo("Ureia", input$ureia),
      campo("Potassio", input$potassio), campo("Magnesio", input$magnesio),
      campo("Hemoglobina", input$hb), campo("Leucocitos", input$leucocitos),
      campo("Plaquetas", input$plaquetas), campo("TGO/TGP", input$tgo_tgp),
      campo("EAS/proteinuria", input$eas_prot), campo("HbA1c", input$hba1c),
      campo("LDL/perfil lipidico", input$ldl),
      campo("Sorologias/NAT", input$virais),
      "== Consulta atual / queixas ==\n",
      campo("Queixas e evolucao", input$queixas)
    )
    
    paste0(
      "Dados desta consulta de seguimento (campos vazios foram omitidos):\n\n",
      bloco,
      "\nGere a SECAO 1 (recomendacoes sucintas), o marcador, e a SECAO 2 ",
      "(consulta estruturada), conforme instruido."
    )
  }
  
  # Tarefa assincrona: cada geracao e independente (sem misturar historico)
  gen_task <- ExtendedTask$new(function(prompt) {
    cl <- ellmer::chat_anthropic(system_prompt = system_prompt, model = MODELO)
    cl$chat_async(prompt)
  }) |> bind_task_button("gerar")
  
  observeEvent(input$gerar, {
    # exige ao menos algum dado preenchido
    if (!nzchar(trimws(paste0(
      input$queixas %||% "", input$creatinina %||% "", input$tacro_nivel %||% "")))) {
      showNotification("Preencha ao menos as queixas ou algum exame.",
                       type = "warning")
      return()
    }
    gen_task$invoke(montar_prompt())
  })
  
  # Quando a resposta chega, separa nas duas secoes
  rec_val <- reactiveVal("")
  observe({
    txt <- gen_task$result()  # aguarda ate concluir
    if (grepl(MARCADOR, txt, fixed = TRUE)) {
      partes <- strsplit(txt, MARCADOR, fixed = TRUE)[[1]]
      rec_val(trimws(partes[1]))
      updateTextAreaInput(session, "consulta_out",
                          value = trimws(paste(partes[-1], collapse = MARCADOR)))
    } else {
      rec_val(txt)
      updateTextAreaInput(session, "consulta_out", value = txt)
    }
  })
  
  output$recomendacoes <- renderUI({
    if (!nzchar(rec_val()))
      return(span(class = "text-muted", "As recomendacoes aparecerao aqui."))
    HTML(gsub("\n", "<br>", htmltools::htmlEscape(rec_val())))
  })
  
  # Limpar todos os campos de texto
  observeEvent(input$limpar, {
    for (id in c("tempo_tx","rejeicao","tacro_nivel","tacro_dose","ciclosporina",
                 "micofenolato","prednisona","mtor","adesao","profilaxias",
                 "pa","fc","temp","peso","imc","creatinina","egfr","ureia",
                 "potassio","magnesio","hb","leucocitos","plaquetas","tgo_tgp",
                 "eas_prot","hba1c","ldl","virais"))
      updateTextInput(session, id, value = "")
    updateTextAreaInput(session, "queixas", value = "")
    updateSelectInput(session, "doador", selected = "Nao informado")
    updateTextAreaInput(session, "consulta_out", value = "")
    rec_val("")
  })
}

shinyApp(ui, server)
